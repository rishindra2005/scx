# Linux Kernel Configuration Requirements for OPTIMA and sched_ext
# Linux 6.12+ / 7.0+
# Target Architectures: x86_64 (AMD Zen 5/5c, Intel Alder/Raptor Lake), AArch64 (ARM big.LITTLE)

# --- sched_ext Subsystem ---
CONFIG_SCHED_CLASS_EXT=y
CONFIG_BPF_SCHED_EXT=y

# --- eBPF & Tracing Core ---
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_BPF_EVENTS=y

# --- Performance Counters & Hardware Monitoring ---
CONFIG_PERF_EVENTS=y
CONFIG_PERF_EVENTS_INTEL_RAPL=y
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=y
CONFIG_INTEL_RAPL_CORE=y
CONFIG_AMD_ENERGY=m

# --- Preemption & High-Resolution Timers ---
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_FULL=y
CONFIG_RCU_NOCB_CPU=y

# --- Multi-Core & Topology Subsystem ---
CONFIG_SMP=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_MC_PRIO=y
CONFIG_SCHED_CORE=y

# --- Resctrl / Cache Allocation Technology (CAT) ---
CONFIG_RESCTRL=y
CONFIG_X86_CPU_RESCTRL=y
